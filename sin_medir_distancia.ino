unsigned long t0, tFin;   // t0 = inicio de la melodia, tFin = instante en que termina la nota actual
int iEsc = 0;

// GIF en curso: cual es, desde que ms de la melodia arranco, que cuadro se ve y cuando toca el siguiente
const Anim* animAct = NULL;
unsigned long animT = 0, animProx = 0;
int animCuadro = -1;

// ===== Texto con fuente de ancho variable (FreeSans / FreeSerif) =====
// x = donde empieza la primera letra, y = linea base, trk8 = ajuste entre letras en 1/8 de punto (negativo = mas juntas).
void textoFnt(const GFXfont* f, int trk8, int x, int y, const char* t) {
  display.setFont(f);
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setTextWrap(false);
  uint8_t primero = pgm_read_byte(&f->first);
  int acum8 = 0;
  for (; *t; t++) {
    display.setCursor(x + acum8 / 8, y);
    display.write(*t);
    acum8 += pgm_read_byte(&f->glyph[(uint8_t)*t - primero].xAdvance) * 8 + trk8;
  }
  display.setFont();                                  // vuelve a la fuente normal
}

// Dibuja el cuadro del GIF que toca segun el reloj. Va por tiempo, no por cuenta: si un cuadro tarda en dibujarse, salta al que corresponde.
void revisaAnim() {
  if (!animAct) return;
  unsigned long dt = (millis() - t0) - animT;           // ms desde que arranco el GIF
  if (dt < animProx) return;                            // todavia no toca cambiar de cuadro
  unsigned long base = 0;
  if (animAct->repetir) { base = dt - dt % animAct->total; dt -= base; }   // vuelve a empezar al terminar
  uint16_t k = 0; unsigned long acc = 0;
  while (k < animAct->n - 1 && dt >= acc + animAct->demoras[k]) { acc += animAct->demoras[k]; k++; }
  animProx = (!animAct->repetir && k == animAct->n - 1) ? 0xFFFFFFFF : base + acc + animAct->demoras[k];   // sin repetir: se queda en el ultimo
  if (k != animCuadro) {
    animCuadro = k;
    display.clearDisplay();
    display.drawBitmap(0, 0, animAct->cuadros[k], ANCHO, ALTO, WHITE);
    display.display();
  }
}

void dibujaEscena(const Escena& e) {
  animAct = e.anim; animT = e.t; animProx = 0; animCuadro = -1;
  if (e.anim) { revisaAnim(); return; }
  display.clearDisplay();
  if (e.img) display.drawBitmap(0, 0, e.img, ANCHO, ALTO, WHITE);
  for (int i = 0; i < e.n; i++) {
    if (e.l[i].f) { textoFnt(e.l[i].f, e.l[i].trk8, e.l[i].x, e.l[i].y, e.l[i].txt); continue; }
    display.setTextSize(e.l[i].tam);
    display.setTextColor(WHITE);
    display.setCursor(e.l[i].x, e.l[i].y);
    display.println(e.l[i].txt);
  }
  display.display();
}

void revisaPantalla() {
  while (escenas[iEsc].t != 0xFFFFFFFF && millis() - t0 >= escenas[iEsc].t) dibujaEscena(escenas[iEsc++]);
  revisaAnim();
}

// Espera hasta el instante t (ms) sin dejar de atender la pantalla
void esperaHasta(unsigned long t) {
  while ((long)(t - millis()) > 0) { revisaPantalla(); delay(1); }
}

// Un paso: tono (o silencio si freq==0) durante "dur" ms, con reloj propio: no se acumula atraso
void paso(int freq, int dur) {
  if (freq > 0) tone(pinBuzzer, freq); else noTone(pinBuzzer);
  tFin += dur;
  esperaHasta(tFin);
}

void setup() {
  pinMode(pinBuzzer, OUTPUT);
  Wire.begin(14, 12); // SDA=14 (D5), SCL=12 (D6)
  delay(300);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.setTextWrap(false);  // evita que el texto que no entra se enrolle a otra fila y la corrompa
  display.clearDisplay();
  display.display();
}

void loop() {
  iEsc = 0;
  animAct = NULL;
  display.clearDisplay();
